# Copy to .env and fill in. Never commit .env.

# Twilio WhatsApp Sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Public base URL (ngrok in dev). Used to build audio URLs and to check Twilio signatures:
# it must be exactly the URL configured in the Twilio sandbox, without the /whatsapp path.
PUBLIC_BASE_URL=https://example.ngrok-free.app

# Language of the text messages sent to the CHW: fr or en
SUNOOGO_LANG=fr

# Referral nurse who receives red-level alerts (WhatsApp, E.164 format)
NURSE_WHATSAPP_TO=whatsapp:+226XXXXXXXX

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (case summary only, never scoring)
ANTHROPIC_API_KEY=

# DHIS2 demo instance
DHIS2_BASE_URL=https://play.dhis2.org/
DHIS2_USERNAME=
DHIS2_PASSWORD=

# ngrok dev tunnel (local development only)
NGROK_AUTHTOKEN=
