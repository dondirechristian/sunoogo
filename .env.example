# Copy to .env and fill in. Never commit .env.

# Twilio WhatsApp Sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Public base URL (ngrok in dev), used to build audio file URLs
PUBLIC_BASE_URL=https://example.ngrok-free.app

# Referral nurse who receives red-level alerts (WhatsApp, E.164 format)
NURSE_WHATSAPP_TO=whatsapp:+226XXXXXXXX

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (case summary only, never scoring)
ANTHROPIC_API_KEY=

# DHIS2 demo instance
DHIS2_BASE_URL=https://play.dhis2.org/
DHIS2_USERNAME=
DHIS2_PASSWORD=
