# Copy to .env and fill in. Never commit .env.

# WhatsApp provider that sends replies: twilio (Twilio sandbox) or meta (Meta WhatsApp Cloud API)
WHATSAPP_PROVIDER=twilio

# Meta WhatsApp Cloud API (free test number). Webhook URL: <PUBLIC_BASE_URL>/whatsapp/meta
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
# App settings > Basic > App secret: used to check the X-Hub-Signature-256 of each webhook
META_APP_SECRET=
# Any string you choose; type the same value as "Verify token" in the Meta webhook settings
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0

# Twilio WhatsApp Sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Public base URL (ngrok in dev). Used to build audio URLs and to check Twilio signatures:
# with Twilio it must be exactly the URL configured in the sandbox, without the /whatsapp path.
PUBLIC_BASE_URL=https://example.ngrok-free.app

# Language of the text messages sent to the CHW: fr or en
SUNOOGO_LANG=fr

# Referral nurse who receives red-level alerts (WhatsApp, E.164 format)
NURSE_WHATSAPP_TO=whatsapp:+226XXXXXXXX

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (case summary only, never scoring)
ANTHROPIC_API_KEY=

# DHIS2 demo instance (public demo credentials; use real ones for a production server)
DHIS2_BASE_URL=https://play.dhis2.org/demo
DHIS2_USERNAME=admin
DHIS2_PASSWORD=district
# Org unit receiving the data (root of the demo database)
DHIS2_ORG_UNIT=ImspTQPwCqd

# ngrok dev tunnel (local development only)
NGROK_AUTHTOKEN=
